#PlayerBulletPrefab Prefab
{
    tag : PlayerBullet
    size : 12
    color : cyan
    sprite : "assets/laserBlue01.png"
    physics : off
    collider : box
    projectile_speed : 950
    projectile_lifetime : 0.7
    projectile_damage : 1
}

#EnemyBulletPrefab Prefab
{
    tag : EnemyBullet
    size : 10
    color : red
    sprite : "assets/laserRed01.png"
    physics : off
    collider : box
    projectile_speed : 300
    projectile_lifetime : 3.0
    projectile_damage : 1
}

#MeteorPrefab Prefab
{
    tag : Meteor
    size : 28
    color : orange
    sprite : "assets/meteorBig.png"
    physics : off
    collider : box
    projectile_speed : 340
    projectile_lifetime : 5.0
    projectile_damage : 3
    projectile_angle : 90
    projectile_friendly_tag : Enemy
}

#GruntPrefab Prefab
{
    tag : Enemy
    size : 32
    color : purple
    sprite : "assets/enemyBlack1.png"
    mass : 1
    gravity : on
    friction : 0.5
    health : 3
    collider : box
    patrol_min : 100
    patrol_max : 1900
    patrol_speed : 80
}

#BossPrefab Prefab
{
    tag : Enemy
    size : 56
    color : magenta
    sprite : "assets/enemyRed1.png"
    mass : 3
    gravity : on
    friction : 0.5
    health : 15
    boss : on
    hp : 15
    collider : box
}

#ExtraSpawnerPrefab Prefab
{
    tag : Spawner
    size : 24
    color : green
    sprite : "assets/spaceStation_018.png"
    mass : 999
    gravity : off
    kinematic : on
    health : 4
    skip_collision : on
    spawn_every : 10
    spawn_prefab : GruntPrefab
    spawn_at_self : on
}

on a
{
    move left
    rotate 180
}

on d
{
    move right
    rotate 0
}

on left
{
    move left
    rotate 180
}

on right
{
    move right
    rotate 0
}

on space
{
    jump
}

on w
{
    jump
}

on up
{
    jump
}

on j
{
    spawn PlayerBulletPrefab
}

on collide Coin
{
    despawn
    heal Player 2
    play pickup
}

on collide Enemy
{
    damage Player 1
    damage 1
    play hurt
}

on collide Turret
{
    damage Player 1
    play hurt
}

on collide Meteor
{
    damage Player 3
    play hurt
}

on collide Portal
{
    victory
    play pickup
}

on timer 4
{
    look_at TurretLeft Player
    TurretLeft.spawn EnemyBulletPrefab
}

on timer 5
{
    look_at TurretMid Player
    TurretMid.spawn EnemyBulletPrefab
}

on timer 6
{
    look_at TurretRight Player
    TurretRight.spawn EnemyBulletPrefab
}

on timer 5
{
    spawn MeteorPrefab at 300 -50
}

on timer 7
{
    spawn MeteorPrefab at 700 -50
}

on timer 6
{
    spawn MeteorPrefab at 1100 -50
}

on timer 8
{
    spawn MeteorPrefab at 1500 -50
}

on timer 9
{
    spawn MeteorPrefab at 1800 -50
}

on timer 60
{
    spawn BossPrefab at 1000 -60
}

after 25
{
    spawn ExtraSpawnerPrefab at 500 100
}

after 50
{
    spawn ExtraSpawnerPrefab at 1500 100
}
