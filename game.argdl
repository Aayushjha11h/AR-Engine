on a
{
    move left
    rotate 180
}

on d
{
    move right
    rotate 0
}

on left
{
    move left
    rotate 180
}

on right
{
    move right
    rotate 0
}

on space
{
    jump
}

on w
{
    jump
}

on up
{
    jump
}

on j
{
    spawn PlayerBulletPrefab
}

on collide Coin
{
    despawn
    heal Player 2
    play pickup
}

on collide Enemy
{
    damage Player 1
    damage 1
    play hurt
}

on collide Turret
{
    damage Player 1
    play hurt
}

on timer 4
{
    look_at TurretLeft Player
    TurretLeft.spawn EnemyBulletPrefab
}

on timer 5
{
    look_at TurretRight Player
    TurretRight.spawn EnemyBulletPrefab
}

on timer 60
{
    spawn BossPrefab at 600 100
}