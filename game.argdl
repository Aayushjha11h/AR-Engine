

#Background Background {
    x : 600
    y : 300
    width : 1400
    height : 800
    sprite : "assets/backgroundBlack.png"
    parallax : 0.1
    skip_collision : on
}

#Player Character {
    x : 600
    y : 500
    size : 32
    color : cyan
    sprite : "assets/playerShip1_blue.png"
    speed : 380
    jump_force : 600
    mass : 1
    gravity : on
    friction : 0.5
    restitution : 0
    health : 10
    invuln_duration : 1.5
    knockback : 160
    collider : box
    tag : Player
}



#Platform Blueprint {
    color : gray
    sprite : "assets/meteorBig.png"
    kinematic : on
    collider : box
}

#SmallPlatform Blueprint extends Platform {
    sprite : "assets/meteorSmall.png"
}

#Coin Blueprint {
    size : 16
    color : yellow
    sprite : "assets/powerupBlue.png"
    gravity : off
    trigger : on
    collider : box
    tag : Coin
}

#Turret Blueprint {
    size : 40
    color : red
    sprite : "assets/turretBase_big.png"
    mass : 999
    gravity : off
    kinematic : on
    health : 8
    tag : Turret
    collider : box
}

#Bullet Blueprint {
    color : cyan
    sprite : "assets/laserBlue01.png"
    physics : off
    collider : box
}

#PlayerBullet Blueprint extends Bullet {
    tag : PlayerBullet
    size : 12
    projectile_speed : 900
    projectile_lifetime : 0.6
    projectile_damage : 1
}

#EnemyBullet Blueprint extends Bullet {
    tag : EnemyBullet
    size : 10
    color : red
    sprite : "assets/laserRed01.png"
    projectile_speed : 260
    projectile_lifetime : 3.0
    projectile_damage : 1
}

#Enemy Blueprint {
    size : 32
    color : purple
    sprite : "assets/enemyBlack1.png"
    mass : 1
    gravity : on
    friction : 0.5
    health : 2
    collider : box
    patrol_speed : 60
    tag : Enemy
}

#Grunt Blueprint extends Enemy {
    patrol_min : 100
    patrol_max : 1100
}

#Boss Blueprint extends Enemy {
    size : 56
    color : magenta
    sprite : "assets/enemyRed1.png"
    mass : 3
    health : 15
    boss : on
    hp : 15
}

#Spawner Blueprint {
    size : 24
    color : green
    sprite : "assets/spaceStation_018.png"
    mass : 999
    gravity : off
    kinematic : on
    health : 4
    tag : Spawner
    skip_collision : on
    spawn_at_self : on
}



#Floor         Platform      at 600  580 {
    width : 1100
    height : 40
}

#WallLeft      Platform      at 50   300 {
    width : 40
    height : 600
}

#WallRight     Platform      at 1150 300 {
    width : 40
    height : 600
}

#PlatformLeft  SmallPlatform at 250  420 {
    width : 200
    height : 20
}

#PlatformRight SmallPlatform at 950  420 {
    width : 200
    height : 20
}

#TurretLeft  Turret at 250 396
#TurretRight Turret at 950 396

#Coin1 Coin at 250  380
#Coin2 Coin at 950  380
#Coin3 Coin at 150  540
#Coin4 Coin at 600  540
#Coin5 Coin at 1050 540
#Coin6 Coin at 600  280

#SpawnerLeft  Spawner at 150  100 {
    spawn_every : 8
    spawn_prefab : Grunt
}

#SpawnerRight Spawner at 1050 100 {
    spawn_every : 10
    spawn_prefab : Grunt
}

#Enemy1 Enemy at 400 540 {
    patrol_min : 200
    patrol_max : 500
}

#Enemy2 Enemy at 800 540 {
    patrol_min : 700
    patrol_max : 1000
}



on a {
    move left
    rotate 180
}

on d {
    move right
    rotate 0
}

on left {
    move left
    rotate 180
}

on right {
    move right
    rotate 0
}

on space {
    jump
}

on w {
    jump
}

on up {
    jump
}

on j {
    spawn PlayerBullet
}

on collide Coin {
    despawn
    heal Player 2
    play pickup
}

on collide Enemy {
    damage Player 1
    damage 1
    play hurt
}

on collide Turret {
    damage Player 1
    play hurt
}

on timer 4 {
    look_at TurretLeft Player
    TurretLeft.spawn EnemyBullet
}

on timer 5 {
    look_at TurretRight Player
    TurretRight.spawn EnemyBullet
}

on timer 60 {
    spawn Boss at 600 100
}