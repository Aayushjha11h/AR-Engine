#PlayerBulletPrefab Prefab
{
    tag : PlayerBullet
    size : 12
    color : cyan
    sprite : "assets/laserBlue01.png"
    physics : off
    collider : box
    projectile_speed : 900
    projectile_lifetime : 0.6
    projectile_damage : 1
}

#EnemyBulletPrefab Prefab
{
    tag : EnemyBullet
    size : 10
    color : red
    sprite : "assets/laserRed01.png"
    physics : off
    collider : box
    projectile_speed : 260
    projectile_lifetime : 3.0
    projectile_damage : 1
}

#GruntPrefab Prefab
{
    tag : Enemy
    size : 32
    color : purple
    sprite : "assets/enemyBlack1.png"
    mass : 1
    gravity : on
    friction : 0.5
    health : 2
    collider : box
    patrol_min : 100
    patrol_max : 1100
    patrol_speed : 60
}

#BossPrefab Prefab
{
